OPENAI_API_KEY=

# Firebase (buyer + merchant auth / Firestore — public web config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Settlement chain: USDC x402 on Arbitrum
# Arbitrum Sepolia: eip155:421614 (default) · Arbitrum One: eip155:42161
# Token, RPC, explorer and EIP-712 domain are derived from the network.
CHAIN_NETWORK=eip155:421614
# RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# EVM 0x… address that receives USDC (merchant payTo)
MERCHANT_ADDRESS=
# Buyer private key for server-side x402 signing (never commit real keys)
BUYER_PRIVATE_KEY=
# Relayer that submits transferWithAuthorization (needs Arbitrum ETH for gas).
# Falls back to BUYER_PRIVATE_KEY when unset.
# FACILITATOR_PRIVATE_KEY=
# Overrides (normally leave unset):
# TOKEN_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# EXPLORER_BASE=https://sepolia.arbiscan.io

# Gas top-up (/buyer/gas): bridges ETH from the parent chain to Arbitrum with
# @arbitrum/sdk. Parent is Ethereum Sepolia for Arbitrum Sepolia, Ethereum for
# Arbitrum One. Defaults to a public RPC; set your own for reliability.
# PARENT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PARENT_EXPLORER_BASE=https://sepolia.etherscan.io
# Per-deposit cap (defaults: 0.05 testnet, 0.005 mainnet)
# BRIDGE_MAX_DEPOSIT_ETH=0.05

# Liquidity routes use Uniswap V3 on Arbitrum One (no API key). Uniswap has no
# USDC liquidity on Arbitrum Sepolia, so on testnet the UI shows a live Arbitrum
# One quote (quote only, never executed). 0 disables.
# DEX_MAINNET_PREVIEW=1

# Optional second EIP-3009 settle asset for multi-merchant / full-build demos.
# Defaults to USDC. Set a distinct token when you have liquidity.
# ALT_SETTLE_TOKEN=0x…
# ALT_SETTLE_SYMBOL=WETH

# Protocol micro-fee → XPoints (merchant still gets the full listed USDC)
PROTOCOL_FEE_BPS=50
TREASURY_ADDRESS=0x00000000000000000000000000000000000000fe

# Optional: DynamoDB catalog instead of Firestore (Lambda / AWS)
# AISLE_TABLE=

# Setup: see scripts/setup-arbitrum-usdc.md
